# PostgreSQL connection string
# Local:      postgresql://postgres:postgres@localhost:5432/mini_erp_crm?schema=public
# Supabase:   postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# Neon:       postgresql://[user]:[password]@[host]/[db]?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mini_erp_crm?schema=public"

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Port the API server listens on
PORT=4000

NODE_ENV=development

# Comma separated list of allowed frontend origins for CORS
CORS_ORIGIN="http://localhost:5173"
